{
  "name": "roofpro-crm",
  "version": "1.0.0",
  "description": "RoofPro CRM - Modern roofing contractor CRM competing with AccuLynx",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "cd backend && npm run build && cd ../frontend && npm run build",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "db:generate": "cd backend && npm run db:generate",
    "db:push": "cd backend && npm run db:push",
    "db:migrate": "cd backend && npm run db:migrate",
    "db:studio": "cd backend && npm run db:studio",
    "start": "cd backend && npm start && cd ../frontend && npm start",
    "start:backend": "cd backend && npm start",
    "start:frontend": "cd frontend && npm start",
    "lint": "cd backend && npm run lint && cd ../frontend && npm run lint",
    "test": "cd backend && npm test && cd ../frontend && npm test",
    "test:all": "npm --prefix backend test && npm --prefix frontend exec -- vitest run",
    "seed:demo": "npm --prefix backend run seed:demo",
    "launch": "powershell -ExecutionPolicy Bypass -File ./scripts/launch.ps1",
    "stop": "powershell -ExecutionPolicy Bypass -File ./scripts/stop.ps1",
    "smoke": "powershell -ExecutionPolicy Bypass -File ./scripts/smoke.ps1",
    "stack:up": "docker compose up -d --build",
    "stack:down": "docker compose down",
    "stack:logs": "docker compose logs -f --tail=120",
    "stack:ps": "docker compose ps"
  },
  "keywords": [
    "roofing-crm",
    "contractor-management",
    "storm-tracking",
    "estimating",
    "scheduling",
    "roofpro"
  ],
  "author": "RoofPro CRM Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
