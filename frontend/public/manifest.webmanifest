    },
    {
      "name": "Create estimate",
      "short_name": "Estimate",
      "description": "Build a branded estimate",
      "url": "/estimates",
      "icons": [{ "src": "/icons/icon-192.svg", "sizes": "192x192", "type": "image/svg+xml" }]
    }
  ]
