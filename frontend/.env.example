# Frontend build-time configuration (copy to .env for local dev)
# Leave VITE_API_URL empty: the app calls /api/v1 and relies on the Vite proxy
# (dev) or nginx reverse proxy (docker) so there are no CORS surprises.
VITE_API_URL=
VITE_SOCKET_URL=http://localhost:5000
VITE_APP_NAME=RoofPro CRM

# MapMap AUCTUM basemap (public, baked into the build). Publish styles with:
#   MAPMAP_API_KEY=snk_... node scripts/publish-map-styles.mjs
# Leave empty to use CARTO raster tiles.
VITE_MAPMAP_STYLE_LIGHT=
VITE_MAPMAP_STYLE_DARK=
# Browser key: scope "maps", allowed_origins = your site. Treat it as public.
VITE_MAPMAP_KEY=
# Public address printed in Marketing Studio QR codes (never localhost for real prints).
VITE_PUBLIC_APP_URL=
