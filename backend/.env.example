# RoofPro CRM Backend Configuration
NODE_ENV=development
PORT=5000

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Logging
LOG_LEVEL=info

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:roofpro123@localhost:5432/roofpro_crm?schema=public

# Redis Configuration
REDIS_URL=redis://localhost:6379

# JWT Secrets
JWT_SECRET=change-this-in-production
JWT_REFRESH_SECRET=change-this-refresh-secret-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# MinIO / S3 Configuration (for file storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=roofpro123
MINIO_BUCKET=roofpro-files

# NOAA Weather Service (reused from Atlas Helios for storm tracking)
NOAA_API_URL=https://api.weather.gov
NOAA_USER_AGENT=(RoofPro CRM, contact@roofprocrm.com)
