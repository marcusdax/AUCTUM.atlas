# ──────────────────────────────────────────────────────────────
# RoofPro CRM — example environment (copy to backend/.env)
# Never commit real secrets. Generated during `npm run launch`.
# ──────────────────────────────────────────────────────────────

# Core
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:5173,http://localhost:5174
LOG_LEVEL=info

# PostgreSQL — when running the API on the host, use localhost:5432.
# Inside docker compose the service name is `postgres` (compose overrides this).
DATABASE_URL=postgresql://postgres:roofpro123@localhost:5432/roofpro_crm?schema=public
DB_HOST=localhost
DB_PORT=5432
DB_NAME=roofpro_crm
DB_USER=postgres
DB_PASSWORD=roofpro123

# Redis (sessions, cache, Socket.IO adapter)
REDIS_URL=redis://localhost:6379

# Auth — CHANGE BOTH IN PRODUCTION (min 48 random chars each)
JWT_SECRET=roofpro-crm-super-secret-key-change-in-production
JWT_REFRESH_SECRET=roofpro-crm-refresh-secret-key-change-in-production

# NOAA / NWS (free public API, no key required)
NOAA_API_URL=https://api.weather.gov
NOAA_USER_AGENT=(RoofPro CRM, contact@roofprocrm.com)

# ── AI gateway (FreeLLMAPI-compatible) ───────────────────────────
# Local deterministic fallback works with all of this empty.
AI_ENABLED=true
# 64 hex chars (32 bytes) used for AES-256-GCM provider-key encryption.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AI_ENCRYPTION_KEY=
AI_DEFAULT_STRATEGY=balanced        # balanced | speed | reliability | priority
AI_REQUEST_TIMEOUT_MS=20000
AI_ALLOW_LOCAL_FALLBACK=true
# Optional external FreeLLMAPI instance (see docs/FREELLMAPI_INTEGRATION.md)
# AI_FREELMAPI_URL=http://host.docker.internal:3001/v1
AI_FREELMAPI_URL=
# Optional bootstrap keys (DB-configured providers take precedence):
# AI_BOOTSTRAP_KEYS={"groq":"gsk_...","google":"AIza..."}
AI_BOOTSTRAP_KEYS=

# ── Optional integrations ───────────────────────────────────────
# QUICKBOOKS_CLIENT_ID=
# QUICKBOOKS_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# EAGLEVIEW_API_KEY=
# HOVER_API_KEY=
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# MapMap server key for storm-zone address lookup (POST /geocode/batch).
# Without it, "Pull leads for this zone" only flags existing leads.
MAPMAP_API_KEY=
# MAPMAP_API_URL=https://api.mapmap.ai
